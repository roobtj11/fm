{
    "name": "forge-master-app",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "update-configs": "npx tsx scripts/update_config_manifest.ts",
        "update-contributors": "node scripts/updateContributors.cjs",
        "dev": "tsx scripts/update_config_manifest.ts && vite --config vite.config.ts",
        "build": "node scripts/clean_dist.mjs && node scripts/updateContributors.cjs && tsx scripts/update_config_manifest.ts && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build --config vite.config.ts",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "start": "vite preview"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "clsx": "^2.1.0",
        "framer-motion": "^11.0.0",
        "lucide-react": "^0.300.0",
        "lz-string": "^1.5.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.21.0",
        "react-toastify": "^11.0.5",
        "tailwind-merge": "^2.2.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.37.1",
        "@types/node": "22.19.19",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@typescript-eslint/eslint-plugin": "^6.14.0",
        "@typescript-eslint/parser": "^6.14.0",
        "@vitejs/plugin-react": "6.0.2",
        "autoprefixer": "^10.4.16",
        "eslint": "^8.55.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "5.9.3",
        "vite": "8.0.13",
        "wrangler": "4.92.0"
    }
}
